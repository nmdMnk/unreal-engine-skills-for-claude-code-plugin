{
  "description": "Unreal Engine Skills for Claude Code hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/unreal-context.sh",
            "commandWindows": "& \"$env:ProgramFiles\\Git\\bin\\bash.exe\" -c 'PATH=/usr/bin:$PATH; exec \"$1\"' _ \"$env:CLAUDE_PLUGIN_ROOT/hooks/unreal-context.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
